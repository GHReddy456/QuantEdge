# QuantEdge Platform Environment Configuration
NODE_ENV=development
PORT=4000

# MongoDB Atlas Database URI (Optional in demo mode - defaults to in-memory/mock persistence if empty)
# Example: mongodb+srv://<user>:<password>@quantedge-cluster.mongodb.net/quantedge?retryWrites=true&w=majority
MONGODB_URI=

# Twelve Data API Provider (Optional in demo mode - falls back to robust local market simulation)
# Obtain free or paid key at https://twelvedata.com
TWELVE_DATA_API_KEY=

# Selected Market Data Provider ('twelve-data' | 'demo')
MARKET_DATA_PROVIDER=twelve-data

# Public API URL for Web Client
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
